# ==============================================================================
# Aura Transcribe - Fastlane Master Automation Pipeline
# ==============================================================================
# Supports:
# - Full QA & Quality Gate Execution (i18n, performance benchmark, JVM tests, model hash)
# - Debug & Release APK / AAB compilation
# - Automated Google Play Metadata & Screenshot publishing via 'supply'
# - Google Play Store Internal Track & Production publishing
# - F-Droid reproducible build metadata validation & export
# ==============================================================================

default_platform(:android)

platform :android do

  desc "Run full Quality Assurance gate (i18n parity, performance benchmarks, unit tests, model checksums)"
  lane :qa do
    UI.header("Running Aura Transcribe Quality Gates")

    UI.message("1. Checking Translation Parity across 6 Locales...")
    sh("python3 ../scripts/check_translations.py")

    UI.message("2. Running Performance & ASR Optimization Benchmarks...")
    sh("python3 ../scripts/bench_performance.py")

    UI.message("3. Running JVM Unit Test Suite...")
    gradle(
      task: "testDebugUnitTest",
      project_dir: ".."
    )

    UI.message("4. Verifying Speech Model SHA-256 Checksums...")
    gradle(
      task: "checkModels",
      project_dir: ".."
    )

    UI.success("✓ All Quality Gates Passed Successfully!")
  end

  desc "Alias for :qa"
  lane :test do
    qa
  end

  desc "Build Debug APK for local testing or Telegram distribution"
  lane :build_debug do
    UI.header("Building Debug APK")
    gradle(
      task: "assembleDebug",
      project_dir: ".."
    )
    UI.success("✓ Debug APK built in app/build/outputs/apk/debug/")
  end

  desc "Build Signed Release APK"
  lane :build_release do
    UI.header("Building Release APK")
    gradle(
      task: "assembleRelease",
      project_dir: ".."
    )
    gradle(
      task: "checkModels",
      project_dir: ".."
    )
    UI.success("✓ Release APK built in app/build/outputs/apk/release/")
  end

  desc "Build Release Android App Bundle (.aab)"
  lane :build_bundle do
    UI.header("Building Release Android App Bundle (AAB)")
    gradle(
      task: "bundleRelease",
      project_dir: ".."
    )
    gradle(
      task: "checkModels",
      project_dir: ".."
    )
    UI.success("✓ Release AAB built in app/build/outputs/bundle/release/")
  end

  desc "Validate Fastlane metadata, screenshots, and changelogs"
  lane :validate_metadata do
    UI.header("Validating Fastlane Metadata Structure")
    
    metadata_dir = File.expand_path("../fastlane/metadata/android/en-US", __FILE__)
    required_files = ["title.txt", "short_description.txt", "full_description.txt"]
    
    required_files.each do |filename|
      path = File.join(metadata_dir, filename)
      UI.user_error!("Missing required metadata file: #{path}") unless File.exist?(path)
      content = File.read(path).strip
      UI.user_error!("Metadata file #{filename} is empty!") if content.empty?
      UI.message("  ✓ #{filename} (#{content.length} chars)")
    end

    # Verify screenshots & icon
    icon_path = File.join(metadata_dir, "images", "icon.png")
    UI.user_error!("Missing icon at: #{icon_path}") unless File.exist?(icon_path)
    UI.message("  ✓ icon.png present")

    screenshots = Dir.glob(File.join(metadata_dir, "images", "phoneScreenshots", "*.png"))
    UI.user_error!("No phone screenshots found in #{metadata_dir}/images/phoneScreenshots/") if screenshots.empty?
    UI.message("  ✓ #{screenshots.length} phone screenshots found")

    # Verify changelog for current versionCode
    version_code = read_version_code
    changelog_path = File.join(metadata_dir, "changelogs", "#{version_code}.txt")
    if File.exist?(changelog_path)
      UI.message("  ✓ changelog for versionCode #{version_code} present: #{changelog_path}")
    else
      UI.important("  ! No specific changelog for versionCode #{version_code} found at #{changelog_path}. Checking fallback...")
    end

    UI.success("✓ Fastlane metadata validation passed!")
  end

  desc "Upload metadata, store listings, and screenshots to Google Play Store without uploading binary"
  lane :upload_metadata do
    validate_metadata
    UI.header("Uploading Metadata to Google Play via Supply")
    
    supply(
      package_name: "com.auratranscribe.app",
      metadata_path: "fastlane/metadata/android",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      skip_upload_changelogs: false,
      validate_only: false
    )
    UI.success("✓ Google Play metadata updated successfully!")
  end

  desc "Publish Release build to Google Play Internal Test Track"
  lane :internal do |options|
    UI.header("Deploying to Google Play Internal Track")

    # Run QA verification first unless skipped
    qa unless options[:skip_qa]

    # Build AAB or use existing
    aab_path = options[:aab] || File.expand_path("../app/build/outputs/bundle/release/app-release.aab", __FILE__)
    apk_path = options[:apk] || File.expand_path("../app/build/outputs/apk/release/app-release.apk", __FILE__)

    if !File.exist?(aab_path) && !File.exist?(apk_path)
      UI.message("Building Release Bundle...")
      build_bundle
    end

    if File.exist?(aab_path)
      UI.message("Publishing AAB to internal track: #{aab_path}")
      supply(
        package_name: "com.auratranscribe.app",
        track: "internal",
        aab: aab_path,
        metadata_path: "fastlane/metadata/android",
        skip_upload_metadata: false,
        skip_upload_images: true,
        skip_upload_screenshots: true
      )
    elsif File.exist?(apk_path)
      UI.message("Publishing APK to internal track: #{apk_path}")
      supply(
        package_name: "com.auratranscribe.app",
        track: "internal",
        apk: apk_path,
        metadata_path: "fastlane/metadata/android",
        skip_upload_metadata: false,
        skip_upload_images: true,
        skip_upload_screenshots: true
      )
    else
      UI.user_error!("Neither release AAB nor APK found for upload.")
    end

    UI.success("✓ Successfully published to Google Play Internal Track!")
  end

  desc "Promote Google Play Internal Track to Production"
  lane :promote_internal_to_production do |options|
    UI.header("Promoting Internal Track to Production Track")
    
    rollout = options[:rollout] || "1.0"
    
    supply(
      package_name: "com.auratranscribe.app",
      track: "internal",
      track_promote_to: "production",
      rollout: rollout,
      metadata_path: "fastlane/metadata/android"
    )
    UI.success("✓ Successfully promoted Internal Track to Production with #{rollout} rollout!")
  end

  desc "Publish Release directly to Google Play Production Track"
  lane :publish_production do |options|
    UI.header("Deploying directly to Google Play Production Track")

    qa unless options[:skip_qa]

    aab_path = options[:aab] || File.expand_path("../app/build/outputs/bundle/release/app-release.aab", __FILE__)
    if !File.exist?(aab_path)
      build_bundle
    end

    rollout = options[:rollout] || "1.0"

    supply(
      package_name: "com.auratranscribe.app",
      track: "production",
      aab: aab_path,
      rollout: rollout,
      metadata_path: "fastlane/metadata/android",
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )
    UI.success("✓ Successfully published to Google Play Production Track!")
  end

  desc "Export metadata and generate F-Droid compatible descriptor YAML"
  lane :fdroid_export do
    UI.header("Exporting F-Droid Package Descriptor & Validating Fastlane Metadata")
    
    validate_metadata
    
    version_name = read_version_name
    version_code = read_version_code
    
    commit_sha = `git rev-parse HEAD`.strip rescue "HEAD"
    
    fdroid_dir = File.expand_path("../build/fdroid", __FILE__)
    FileUtils.mkdir_p(fdroid_dir)
    
    fdroid_yaml = <<~YAML
      # ==============================================================================
      # F-Droid Metadata Descriptor for Aura Transcribe
      # Auto-generated by Fastlane fdroid_export lane
      # ==============================================================================
      Categories:
        - Multimedia
        - System
      License: MIT
      AuthorName: Aura Transcribe Contributors
      SourceCode: https://github.com/marodriguezd/android_transcribe_app
      IssueTracker: https://github.com/marodriguezd/android_transcribe_app/issues
      Changelog: https://github.com/marodriguezd/android_transcribe_app/releases
      
      AutoName: Aura Transcribe
      Summary: Real-time, private, offline speech-to-text on Android
      Description: |
        Aura Transcribe is a fully on-device, offline, privacy-first speech recognition
        and transcription keyboard and dictation tool for Android.
        
        Features:
        * On-Device Neural ASR (Nemotron 3.5 Streaming, Q8_0 GGUF)
        * Low latency streaming transcription with real-time preview
        * Native Bluetooth headset and AudioRecord bridge support
        * System-wide IME Keyboard and Floating Dictation Overlay
        * 33 selectable languages with automatic language detection
        * No telemetry and no analytics; speech recognition never leaves the device

        Speech recognition is always local. Optional AI post-processing is off by
        default and must be configured by the user; if it is pointed at a remote
        OpenAI-compatible provider, the recognised text (never the audio) is sent
        to that provider with the user's own API key.

      RepoType: git
      Repo: https://github.com/marodriguezd/android_transcribe_app.git

      Builds:
        - versionName: '#{version_name}'
          versionCode: #{version_code}
          commit: '#{commit_sha}'
          subdir: app
          gradle:
            - assembleRelease
          prebuild:
            - export ANDROID_NDK_HOME=$$NDK$$
            - cargo ndk -t arm64-v8a -o app/src/main/jniLibs build --release
          ndk: 28.2.13676358

      AutoUpdateMode: Version v%v
      UpdateCheckMode: Tags
      CurrentVersion: '#{version_name}'
      CurrentVersionCode: #{version_code}
    YAML

    descriptor_path = File.join(fdroid_dir, "com.auratranscribe.app.yml")
    File.write(descriptor_path, fdroid_yaml)
    
    UI.message("  ✓ Generated F-Droid descriptor: #{descriptor_path}")
    UI.message("  ✓ Version: #{version_name} (Code: #{version_code})")
    UI.message("  ✓ Commit: #{commit_sha}")
    UI.success("✓ F-Droid export completed successfully at: #{fdroid_dir}")
  end

  desc "Clean gradle build cache"
  lane :clean do
    gradle(
      task: "clean",
      project_dir: ".."
    )
  end

end

# ==============================================================================
# Helper Methods
# ==============================================================================

def read_version_name
  gradle_file = File.expand_path("../app/build.gradle.kts", __FILE__)
  if File.exist?(gradle_file)
    content = File.read(gradle_file)
    if content =~ /versionName\s*=\s*"([^"]+)"/
      return $1
    end
  end
  "0.2.2"
end

def read_version_code
  gradle_file = File.expand_path("../app/build.gradle.kts", __FILE__)
  if File.exist?(gradle_file)
    content = File.read(gradle_file)
    if content =~ /versionCode\s*=\s*(\d+)/
      return $1.to_i
    end
  end
  41
end
