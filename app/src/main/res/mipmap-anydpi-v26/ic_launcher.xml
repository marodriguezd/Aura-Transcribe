<?xml version="1.0" encoding="utf-8"?>
<!-- Lint reports [ObsoleteSdkInt] here because minSdk is 26, so the -v26
     qualifier looks redundant. It is NOT: renaming this folder to
     mipmap-anydpi makes AAPT2 fail with "resource mipmap/ic_launcher not
     found" (verified twice), because an unversioned anydpi qualifier would
     let the API-26-only <adaptive-icon> (and its API-33 <monochrome> child)
     satisfy the manifest reference on every API level. Keep the qualifier. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
