<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:padding="12dp">

    <!-- Status row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/ime_status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ime_tap_to_record"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:singleLine="true"
            android:ellipsize="end"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"/>

        <ProgressBar
            android:id="@+id/ime_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="6dp"
            android:visibility="gone"/>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/ime_pp_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/ime_ai_fix_toggle"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!-- No minWidth/minHeight=0dp overrides: the framework button's own
             minimum keeps the effective hit target at 48dp. Only the
             horizontal padding is tightened so the row stays compact.

             Its position after the AI-fix switch is deliberate, so lint's
             [ButtonOrder] "cancel should be on the left" does not apply: that
             check assumes a dialog's Cancel/OK pair, and this row is an IME tool
             strip whose other controls are a status line, a progress spinner and
             a switch. (The warning even renders both sides of its own message as
             "Cancel", which is what it does when there is no affirmative button
             to order against.) -->
        <Button
            android:id="@+id/ime_cancel"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/action_cancel"
            android:textColor="?attr/colorError"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Live streaming partial transcription (Nemotron etc.): a two-line
         window that always shows the LATEST words. The ScrollView is
         auto-scrolled to the bottom on every partial, so the tail of the
         hypothesis never scrolls out of view the way the old single
         truncated status line did. Hidden until the first partial arrives. -->
    <ScrollView
        android:id="@+id/ime_partial_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_result"
        android:padding="8dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">

        <TextView
            android:id="@+id/ime_partial_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:maxLines="2"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="?attr/colorOnSurface"
            android:textAppearance="?attr/textAppearanceBodyLarge"/>
    </ScrollView>

    <!-- Record area: pulsing mic-level glow behind a circular record button.
         The layout is deliberately compact (a keyboard surface, not a full
         Activity). The whole container is the 132dp tap target; the icon and
         circle are decoration. TalkBack semantics come from ime_hint, which the
         service keeps in sync with the live state (tap to record / tap to
         stop), so it is exposed as a polite live region instead of freezing a
         description here. -->
    <FrameLayout
        android:id="@+id/ime_record_container"
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:clickable="true"
        android:focusable="true">

        <dev.notune.transcribe.MicLevelView
            android:id="@+id/ime_mic_level"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:layout_gravity="center"/>

        <View
            android:id="@+id/ime_record_circle"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ime_record"/>

        <!-- Decorative: a state indicator (mic vs. headset) drawn inside the
             clickable container above. It performs no action, so it is hidden
             from accessibility services rather than announced with a
             misleading label. -->
        <ImageView
            android:id="@+id/ime_mic_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_mic"
            android:layout_gravity="center"
            android:importantForAccessibility="no"/>

        <TextView
            android:id="@+id/ime_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ime_tap_to_record"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="8dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="?attr/textAppearanceBodySmall"/>
    </FrameLayout>

    <!-- Bottom key row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingTop="8dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ime_switch_keyboard"
            android:layout_width="52dp"
            android:layout_height="@dimen/min_touch_target"
            android:src="@drawable/ic_keyboard_switch"
            android:scaleType="centerInside"
            android:background="@drawable/bg_ime_key"
            app:tint="?attr/colorOnSurfaceVariant"
            android:clickable="true"
            android:focusable="true"
            android:importantForAccessibility="yes"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/ime_cd_switch_keyboard"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ime_space"
            android:layout_width="0dp"
            android:layout_height="@dimen/min_touch_target"
            android:layout_weight="1"
            android:src="@drawable/ic_space"
            android:scaleType="centerInside"
            android:background="@drawable/bg_ime_key"
            app:tint="?attr/colorOnSurfaceVariant"
            android:clickable="true"
            android:focusable="true"
            android:importantForAccessibility="yes"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/ime_cd_space"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ime_enter"
            android:layout_width="64dp"
            android:layout_height="@dimen/min_touch_target"
            android:src="@drawable/ic_enter"
            android:scaleType="centerInside"
            android:background="@drawable/bg_ime_key"
            app:tint="?attr/colorOnSurfaceVariant"
            android:clickable="true"
            android:focusable="true"
            android:importantForAccessibility="yes"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/ime_cd_enter"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ime_backspace"
            android:layout_width="64dp"
            android:layout_height="@dimen/min_touch_target"
            android:src="@drawable/ic_backspace"
            android:scaleType="centerInside"
            android:background="@drawable/bg_ime_key"
            app:tint="?attr/colorOnSurfaceVariant"
            android:clickable="true"
            android:focusable="true"
            android:importantForAccessibility="yes"
            android:contentDescription="@string/ime_cd_backspace"/>
    </LinearLayout>

</LinearLayout>
