<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="72dp"
    android:layout_height="72dp">

    <!-- The circle carries the action's accessible label; the glyph inside is
         purely decorative and is therefore hidden from the accessibility tree
         so TalkBack does not announce the same target twice. -->
    <View
        android:id="@+id/dismiss_target_circle"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_dismiss_circle"
        android:contentDescription="@string/floating_action_cancel" />

    <ImageView
        android:id="@+id/dismiss_target_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_close"
        app:tint="@color/overlay_scrim_fg" />
</FrameLayout>
