<?xml version="1.0" encoding="utf-8"?>
<!--
  Prominent in-app disclosure for the optional Accessibility service.

  Shown as its own screen, immediately before the user is sent to Android's
  Accessibility settings — not buried in a settings list, a privacy policy or the
  store listing. Structure follows the Google Play "prominent disclosure"
  guidance: what the app will see, why it is needed, that it is optional, and how
  to turn it off, each as a separate, readable section.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/a11y_disclosure_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Lint reports [UselessParent] here and suggests moving the background up
         onto this LinearLayout. Do NOT: the root FrameLayout is the view the
         insets listener gets, and AccessibilityDisclosureActivity applies the
         system-bar insets to it with setPadding(insets.left, insets.top,
         insets.right, insets.bottom). Any horizontal spacing therefore has to
         live on the child as a *margin*, because a padding on the root would be
         overwritten by that setPadding on every inset change. The parent carries
         the full-bleed surface colour, the child carries the reading-column
         margins; neither is redundant. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/content_horizontal_margin"
        android:layout_marginEnd="@dimen/content_horizontal_margin">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_close"
            app:title="@string/a11y_disclosure_title" />

        <ScrollView
            android:id="@+id/disclosure_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/a11y_disclosure_intro"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/a11y_disclosure_what_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/a11y_disclosure_what_body"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/a11y_disclosure_why_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/a11y_disclosure_why_body"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/a11y_disclosure_control_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/a11y_disclosure_control_body"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </ScrollView>

        <!-- Explicit consent. The user is only taken to Android's Accessibility
             settings after choosing Continue; nothing is enabled automatically. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_disclosure_continue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/a11y_disclosure_consent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_disclosure_decline"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text="@string/a11y_disclosure_decline" />
    </LinearLayout>
</FrameLayout>
