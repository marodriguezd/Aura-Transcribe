<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The app runs inference on the CPU (ggml); GLES 3.2 is not used.
         required=false so devices/emulators without a GLES 3.2 driver can
         still install the app. -->
    <uses-feature android:glEsVersion="0x00030002" android:required="false" />
    <!-- Voice input needs a microphone, but the app is also useful without one
         (audio-file transcription, live subtitles over system audio), so the
         hardware is not declared as required and Play will not filter the app
         off tablets that lack one. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- BLUETOOTH_CONNECT (API 31+) is used to read the connected audio device
         name and to select a headset microphone. The legacy BLUETOOTH
         permission is only granted up to API 30. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- AI post-processing (fork addition): calls an OpenAI-compatible API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- READ_USER_DICTIONARY is deliberately NOT declared. The platform keeps it out of
         the public SDK (android.Manifest.permission has no such constant), so an app
         targeting a modern SDK can never be granted it; declaring it only advertised
         access the app could not hold. Android's Personal Dictionary stays reachable from
         the UI (see UserDictionaryHelper) and the native corrector reads the app's own
         custom_words marker. -->

    <!-- Package visibility (Android 11+): lets resolveActivity()/queryIntentActivities()
         for the speech intent see other handlers, so MainActivity can tell whether this
         app is the resolved handler or a chooser would appear. -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <!-- android:supportsRtl="true": every layout is written with
         start/end attributes and no hard-coded Gravity.LEFT/RIGHT anywhere in
         Java, so mirroring is correct for RTL locales. The floating bubble is
         positioned with absolute window X coordinates, which the platform does
         NOT mirror, so its left/right drag-and-snap behaviour is unaffected. -->
    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme"
        android:hasCode="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Main Activity.
             No android:configChanges: the screen is recreation-safe by design
             (the in-flight model download tracks a static, sActiveInstance is
             resolved at completion, and mic test state is torn down in
             onPause/onDestroy), so letting the platform recreate it on
             rotation/window resize is correct on phones, tablets, foldables and
             desktop-style windows alike. -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Speech model management -->
        <activity
            android:name=".ModelsActivity"
            android:label="@string/models_title"
            android:exported="false" />

        <!-- AI post-processing settings (fork addition) -->
        <activity
            android:name=".PostProcessSettingsActivity"
            android:label="@string/pp_card_title"
            android:exported="false" />

        <!-- Custom words dictionary editor (fork addition) -->
        <activity
            android:name=".CustomWordsActivity"
            android:label="@string/cw_title"
            android:exported="false" />

        <!-- Prominent in-app disclosure for the optional Accessibility service.
             Shown immediately before the user is sent to Android's Accessibility
             settings, so consent is informed, in-context and separate from any
             other screen (Google Play "Use of AccessibilityService APIs"). -->
        <activity
            android:name=".AccessibilityDisclosureActivity"
            android:label="@string/a11y_disclosure_title"
            android:exported="false" />

        <!-- Live Subtitles Activity: configuration + permissions. Uses the app
             theme so the screen is a normal (opaque) start/config page where
             the user picks the translation target before starting. -->
        <activity
            android:name=".LiveSubtitleActivity"
            android:theme="@style/AppTheme"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:exported="false" />

        <!-- RecognizerIntent entry point (for SwiftKey chooser).
             android:configChanges is retained HERE and only here, and that is a
             deliberate exception: an in-flight dictation is bound to this
             Activity instance through a JNI global reference plus a session
             generation id, so recreating the Activity mid-recording would orphan
             the live session and drop the user's transcript. The configuration
             change is handled in place by RecognizeActivity.onConfigurationChanged,
             which re-reads the metrics it needs. -->
        <activity
            android:name=".RecognizeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:theme="@style/AppTheme.VoicePanel">

            <intent-filter>
                <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Transcribe shared audio file -->
        <activity
            android:name=".TranscribeFileActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/AppTheme">

            <!-- Handle "Share" from other apps -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>

            <!-- Handle "Open with" for audio files. tools:ignore is justified:
                 this is an audio/* mime handler, not an app link — there is no
                 http(s) URL/domain to verify, so AppLinkUrlError is a false
                 positive here (adding autoVerify would claim a fake domain). -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!-- Live Subtitles Service.
             foregroundServiceType="mediaProjection" matches what the service
             actually does (system audio capture through a user-granted
             MediaProjection). LiveSubtitleService obtains the projection BEFORE
             calling startForeground with this type, which Android 14+ requires. -->
        <service
            android:name=".LiveSubtitleService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />

        <!-- Speech-to-text provider for other keyboards (SwiftKey, Gboard, …).
             Declared in the manifest so it is always discoverable via
             SpeechRecognizer, even when the app process isn't running.
             Protected by BIND_RECOGNITION_SERVICE, so only the system can bind. -->
        <service
            android:name=".VoiceRecognitionService"
            android:label="@string/recognition_service_label"
            android:permission="android.permission.BIND_RECOGNITION_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <!-- IME Service. Protected by BIND_INPUT_METHOD, so only the system can
             bind; android:label is what the user sees in the keyboard picker. -->
        <service
            android:name=".RustInputMethodService"
            android:label="@string/app_name"
            android:icon="@drawable/ic_launcher_aura_transcribe"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Accessibility Service for floating dictation auto-insert.
             android:label / android:description come from dedicated strings that
             describe the service's actual, narrow purpose — they are the text the
             user reads in Android Settings when deciding whether to grant
             access, and they must not just repeat the app name. -->
        <service
            android:name=".FloatingDictationAccessibilityService"
            android:label="@string/accessibility_service_name"
            android:description="@string/accessibility_service_description"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Floating Overlay Service. stopWithTask=false so the bubble survives
             swiping the app out of recents (a floating dictation bubble is meant
             to keep working while you use other apps).

             foregroundServiceType="microphone" is required because the service
             captures audio itself: Java-side AudioRecordBridge feeds the native
             engine through pushAudioDirect(). The microphone type is held for as
             long as the bubble is enabled, on purpose — see the note in
             FloatingOverlayService.onCreate about why the type is established
             while the app is in the foreground rather than added later. -->
        <service
            android:name=".FloatingOverlayService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="microphone" />

    </application>
</manifest>
